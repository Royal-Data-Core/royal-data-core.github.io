{
  "name": "royal-data-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Royal Data Core LTDA — consultoria em testes de software. Site estatico hibrido (vitrine B2B + blog tecnico).",
  "license": "MIT",
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync": "astro sync",
    "build": "astro build && npm run build:pagefind && npm run verify:pagefind",
    "build:pagefind": "pagefind --site dist",
    "verify:pagefind": "node -e \"const f=require('node:fs');for(const p of ['dist/_pagefind/pagefind.js','dist/_pagefind/pagefind.wasm','dist/_pagefind/pagefind-entry.json']){if(!f.existsSync(p)){console.error('[SPEC-007] indice Pagefind nao gerado: '+p);process.exit(1)}}console.log('✓ pagefind index ok')\"",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \".ai/**/*.md\" \"#node_modules\"",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:security": "node scripts/audit-bundle.mjs --dist dist",
    "lint:topology": "node scripts/lint-topology.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:bundle": "node scripts/audit-bundle.mjs --dist dist",
    "verify:deps": "node scripts/verify-no-postinstall.mjs",
    "pin:actions": "bash scripts/pin-actions.sh",
    "pin:actions:check": "bash scripts/pin-actions.sh --check",
    "test": "npm run test:unit && npm run test:e2e && npm run test:a11y",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:links": "linkinator ./dist --recurse --verbosity ERROR --skip \"https://www.linkedin.com/*,https://wa.me/*,https://github.com/*\" --output json --output-path .linkinator/",
    "test:lh": "lhci autorun --config=lighthouserc.json",
    "new:post": "node scripts/new-post.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@pagefind/default-ui": "^1.3.0",
    "astro": "^5.0.0",
    "pagefind": "^1.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "linkinator": "^6.1.0",
    "markdownlint-cli2": "^0.15.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,mjs}": ["eslint --fix --max-warnings 0", "prettier --write"],
    "*.{md,mdx}": ["markdownlint-cli2 --fix", "prettier --write"],
    "*.{json,css,yml,yaml}": ["prettier --write"]
  }
}
