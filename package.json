{
  "name": "royal-data-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Royal Data Core LTDA — consultoria em testes de software. Site estatico hibrido (vitrine B2B + blog tecnico).",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync": "astro sync",
    "build": "astro build && npm run build:pagefind && npm run verify:pagefind",
    "build:pagefind": "pagefind --site dist --output-subdir _pagefind",
    "verify:pagefind": "node -e \"const fs=require('node:fs');for(const p of ['dist/_pagefind/pagefind.js','dist/_pagefind/pagefind-entry.json']){if(!fs.existsSync(p)){console.error('[SPEC-007] indice Pagefind nao gerado: '+p);process.exit(1)}}const wasm=fs.readdirSync('dist/_pagefind').some(n=>n.startsWith('wasm.')&&n.endsWith('.pagefind'))||fs.existsSync('dist/_pagefind/pagefind.wasm');if(!wasm){console.error('[SPEC-007] wasm do Pagefind ausente em dist/_pagefind/');process.exit(1)}console.log('✓ pagefind index ok')\"",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:security": "node scripts/audit-bundle.mjs --dist dist",
    "generate:og": "node scripts/generate-og.mjs",
    "lint:topology": "node scripts/lint-topology.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:deps": "node scripts/verify-no-postinstall.mjs",
    "pin:actions": "bash scripts/pin-actions.sh",
    "pin:actions:check": "bash scripts/pin-actions.sh --check",
    "test": "npm run test:unit && npm run test:e2e && npm run test:a11y",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:links": "node scripts/test-links.mjs",
    "test:lh": "lhci autorun --config=lighthouserc.json",
    "new:post": "node scripts/new-post.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^7.4.0",
    "pagefind": "^1.3.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "globals": "^16.5.0",
    "husky": "^9.1.0",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "proxy-agent": "8.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "lighthouse": "^13.5.0",
    "basic-ftp": "^6.2.3",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "inquirer": "^8.2.7",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.9.1",
    "katex": "^0.19.0",
    "eslint-plugin-astro": {
      "astro-eslint-parser": "^2.1.0"
    }
  }
}
