// static-analysis-enforcer — lint:md (CONSTITUTION §C12.7 · §C11c)
// Escopo: **/*.md — a SUPERFÍCIE PUBLICADA do produto (README, .github,
// qualquer doc pública futura). O corpus interno (.ai/**, .opencode/**,
// /specs/**, /specs-*/**) é LOCAL-ONLY (ADR-009 D1): os ignores abaixo são
// uma INVARIANTE — esta gate precisa avaliar exatamente o mesmo conjunto de
// arquivos no operator local (com corpus) e no checkout de CI (sem corpus).
// Artefatos/generated dirs ignorados.
//
// Regras off — cada uma com justificativa de formato autorado do README
// (não são gates de segurança; Kill Switch vive em lint:security/test:lh):
//   MD013 — tabelas raio-X excedem 80 col por design.
//   MD022/MD031/MD032/MD058 — blank-lines-around-* : README autorado sem
//           essa convenção; fix agora é nossa responsabilidade direta —
//           documentada, não herdada de corpus interno.
//   MD060 — table-column-style dispara em TODA tabela do README.
//   MD040 — fences anônimos nos runbooks são o padrão do documento.
//   MD041 — README abre com <div> de badges; PR template abre "## 🔗".
//   MD033/MD034/MD051 — README usa <div> de badges e URL bare na seção topo.
//   MD047 — arquivos que terminam sem newline são de conteúdo gerado.
{
  "config": {
    "MD013": false,
    "MD022": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD040": false,
    "MD041": false,
    "MD047": false,
    "MD051": false,
    "MD058": false,
    "MD060": false,
  },
  "ignores": [
    ".ai/**",
    ".opencode/**",
    "specs/**",
    "specs-*/**",
    ".log-extract/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "node_modules/**",
  ],
}
