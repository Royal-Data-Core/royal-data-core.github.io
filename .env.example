# Public variables (safe to expose in client bundle)
# These are embedded at build time by Astro.
PUBLIC_FORMSPREE_ID=your_formspree_id_here
PUBLIC_GOATCOUNTER_URL=https://your-site.goatcounter.com/count
PUBLIC_SITE_URL=https://your-domain.com

# Secret variables (server-only, never in client bundle)
# LHCI_GITHUB_APP_TOKEN=your_lhci_token_here
