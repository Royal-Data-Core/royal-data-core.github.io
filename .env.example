# Public variables (safe to expose in client bundle) — embedded at build time.
#
# D-03 (SDD-CONTEXT §9) RESOLVED 2026-10-20 — official channels defined:
#   royaldatacore@gmail.com · +5516997148778 (WhatsApp + telefone)
#   Instagram @royaldatacore · LinkedIn /in/leonardo-setti (D-04)
# The values below are PUBLIC by design (SEC-1 untouched) and are duplicated
# in the CI build env (ci.yml Build step). When they are absent the site still
# renders the SSOT placeholders `[[EMAIL]]` / `[[PHONE]]` (CONSTITUTION §C9
# prohibits fabrication).
#
# Formats:
#   PUBLIC_CONTACT_EMAIL — full address, e.g. contato@royal-data-core.com.br
#   PUBLIC_CONTACT_PHONE — digits only WITH country code, e.g. 5516999999999
#     (feeds both tel:+55… and https://wa.me/55…, SPEC-005 AC-005.4)
#
# NEVER put secrets here (RFC: `SECRET_` / token_* names are rejected by the gate):
# this file is for PUBLIC_ values only.
PUBLIC_CONTACT_EMAIL=royaldatacore@gmail.com
PUBLIC_CONTACT_PHONE=5516997148778

# SITE / SITE_BASE feed astro.config.mjs (ADR-004 — read-only for frontend agents).
# SITE must be an absolute https:// URL. SITE_BASE is "/" for the org/user site
# (repo <owner>.github.io) or "/<repo>/" for project sites (ADR-008 D7:
# shell-side origin/base resolution in CI; local value below matches the
# current deployment topology).
#
# CI injects these per job (SITE_URL + SITE_BASE for tests = same values).
SITE=https://royal-data-core.github.io
SITE_BASE=/
