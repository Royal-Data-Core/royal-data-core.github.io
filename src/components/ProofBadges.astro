---
import Icon from "./Icon.astro";
import { DEFAULT_LOCALE, type Locale } from "../lib/i18n";

interface Props {
  /** SPEC-012 — rendered locale. */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
/**
 * SPEC-002 AC-002.3 — proof badges resolved at BUILD time, no external badge
 * hosts (no img.shields.io), no fetch().
 *
 * Honesty rationale (§C9 / mission contract):
 * - `proof-build-status` "build: passing" is emitted during a render that only
 *   ships when the ENTIRE pipeline (astro build → pagefind → verify:pagefind →
 *   bundle audit) succeeds; a build that fails after render never reaches
 *   dist/ or deploy. Static text, never runtime-computed.
 * - `proof-lighthouse-score` / `proof-tests-passing` are intentionally OMITTED:
 *   LHCI/Vitest numbers are not available to the page renderer at render time
 *   and printing unverifiable numbers is prohibited (§C9).
 */
---

<ul class="flex flex-col gap-2 text-sm">
  <li
    data-testid="proof-build-status"
    class="bg-surface border-border-strong text-ink inline-flex min-h-[44px] items-center gap-2 rounded-md border px-3 font-mono text-xs font-semibold"
  >
    <Icon name="check-circle" size={16} class="text-success-600" />
    build: passing
  </li>
  <!-- Non-verifiable badges (light score, test count) omitted per SPEC-002 AC-002.5 + §C9. -->
  <li
    class="bg-surface border-border-strong text-ink inline-flex min-h-[44px] items-center gap-2 rounded-md border px-3 font-mono text-xs font-semibold"
  >
    <Icon name="coin" size={16} class="text-success-600" />
    {locale === "en" ? "site cost: R$ 0,00 / month" : "custo mensal: R$ 0,00"}
  </li>
</ul>
