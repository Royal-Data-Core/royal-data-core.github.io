---
/**
 * SPEC-001 — site header with the closed navigation set (início / serviços / blog / contato ).
 * Identifiers are EN (ADR-000): testids `nav-link-home` etc. even though routes are PT-BR.
 * SPEC-010 §4 — brand lockup + theme-aware tokens (surface/hairline/ink).
 */
import { withBase } from "../lib/withBase";
import Brand from "./Brand.astro";

const NAV_ITEMS = [
  { label: "Início", href: withBase("/"), testid: "nav-link-home" },
  {
    label: "Serviços",
    href: withBase("/servicos"),
    testid: "nav-link-services",
  },
  { label: "Blog", href: withBase("/blog"), testid: "nav-link-blog" },
  { label: "Contato", href: withBase("/contato"), testid: "nav-link-contact" },
] as const;
---

<header
  data-testid="site-header"
  class="border-border bg-surface/95 sticky top-0 z-30 border-b backdrop-blur-sm"
>
  <nav
    data-testid="nav-primary"
    aria-label="Navegação principal"
    class="container-page flex min-h-[64px] flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3"
  >
    <Brand />
    <ul class="flex flex-wrap items-center gap-1">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              data-testid={item.testid}
              class="hover:text-link-hover text-ink-muted inline-flex min-h-[44px] items-center rounded-md px-3 text-sm font-medium underline-offset-4 hover:underline"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
