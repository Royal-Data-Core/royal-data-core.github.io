---
/**
 * Service card (SPEC-002 §Serviços; SPEC-003 AC-003.3 shape).
 * `data-testid="service-card-<slug>"` and `data-testid="service-cta-<slug>"` are mandatory.
 * CTA: entity-encoded mailto (SPEC-005 AC-005.3) when the email channel exists;
 * otherwise routes to /contato, where the pending state (D-03) is explained.
 */
import { withBase } from '../lib/withBase';
import {
  CONTACT_EMAIL,
  HAS_CONTACT_EMAIL,
  buildMailtoHrefEncoded,
} from '../lib/contact';

interface ServiceCta {
  /** Visible label (COPY-BRIEF verbatim, PT-BR). */
  label: string;
  /** ADR-003 D4 qualified subject; enables the mailto path. */
  subject?: string;
  /** Explicit href override (rare; internal route only). */
  href?: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  eyebrow?: string;
  deliverables?: ReadonlyArray<string>;
  ctas: ReadonlyArray<ServiceCta>;
  /** SPEC-003 AC-003.2 — textual audience marker (non-color signal). */
  audience?: 'b2b' | 'clt';
  /** Optional pre-filled mailto body (AC-005.2: razão social + origin URL). */
  mailtoBody?: string;
}

const { slug, title, description, eyebrow, deliverables, ctas, audience, mailtoBody } =
  Astro.props;

// Fail closed on missing labels (§C9 + SPEC-001): no undefined reaches the template.
ctas.forEach((cta, index) => {
  if (!cta.label) {
    throw new Error(
      `SPEC-002: ServiceCard '${slug}' possui CTA sem label (index ${index})`,
    );
  }
});

const mailtoCta = CONTACT_EMAIL
  ? ctas.find((cta) => typeof cta.subject === 'string')
  : undefined;

const encodedMailto =
  mailtoCta && CONTACT_EMAIL
    ? buildMailtoHrefEncoded(
        CONTACT_EMAIL,
        mailtoCta.subject as string,
        mailtoBody,
      )
    : null;
---

<article
  data-testid={`service-card-${slug}`}
  class="flex h-full flex-col gap-3 rounded-lg border border-slate-200 bg-surface p-5"
  {...(audience ? { 'data-audience': audience } : {})}
>
  {eyebrow ? (
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">{eyebrow}</p>
  ) : null}
  <h3 class="text-lg font-bold leading-snug text-slate-900">{title}</h3>
  <p class="text-sm leading-relaxed text-slate-700">{description}</p>
  {
    deliverables && deliverables.length > 0 ? (
      <ul
        data-testid={`service-deliverables-${slug}`}
        class="list-disc space-y-1 pl-5 text-sm text-slate-700"
      >
        {deliverables.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : null
  }
  <div class="mt-auto flex flex-col items-start gap-2 pt-2">
    {
      ctas.map((cta) =>
        cta.href ? (
          <a
            data-testid={`service-cta-${slug}`}
            href={withBase(cta.href)}
            class="inline-flex min-h-[44px] min-w-[44px] items-center rounded-md border border-brand-700 px-4 text-sm font-semibold text-brand-700 underline-offset-4 hover:bg-brand-700 hover:text-white"
          >
            {cta.label}
          </a>
        ) : HAS_CONTACT_EMAIL && CONTACT_EMAIL && encodedMailto && cta.subject ? (
          <a
            data-testid={`service-cta-${slug}`}
            href={encodedMailto.hrefEncoded}
            aria-label={encodedMailto.addressDecoded}
            class="inline-flex min-h-[44px] min-w-[44px] items-center rounded-md border border-brand-700 px-4 text-sm font-semibold text-brand-700 underline-offset-4 hover:bg-brand-700 hover:text-white"
          >
            {cta.label}
          </a>
        ) : (
          <a
            data-testid={`service-cta-${slug}`}
            href={withBase('/contato')}
            title="Canal de contato pendente — decisão D-03 (SDD-CONTEXT §9)"
            class="inline-flex min-h-[44px] min-w-[44px] items-center rounded-md border border-slate-300 px-4 text-sm font-semibold text-slate-700 underline-offset-4 hover:border-brand-700 hover:text-brand-700"
          >
            {cta.label}
          </a>
        ),
      )
    }
  </div>
</article>
