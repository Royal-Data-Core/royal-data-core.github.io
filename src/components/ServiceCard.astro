---
/**
 * Service card (SPEC-002 §Serviços; SPEC-003 AC-003.3 shape).
 * `data-testid="service-card-<slug>"` and `data-testid="service-cta-<slug>"` are mandatory.
 * CTA: entity-encoded mailto (SPEC-005 AC-005.3) when the email channel exists;
 * otherwise routes to /contato, where the pending state (D-03) is explained.
 */
import Icon, { type IconName } from "./Icon.astro";
import { withBase } from "../lib/withBase";
import { DEFAULT_LOCALE, ROUTES, type Locale } from "../lib/i18n";
import {
  CONTACT_EMAIL,
  HAS_CONTACT_EMAIL,
  buildMailtoHrefEncoded,
} from "../lib/contact";

interface ServiceCta {
  /** Visible label (COPY-BRIEF verbatim, PT-BR). */
  label: string;
  /** ADR-003 D4 qualified subject; enables the mailto path. */
  subject?: string;
  /** Explicit href override (rare; internal route only). */
  href?: string;
}

interface Props {
  slug: string;
  /** SPEC-010 §7 — ícone do serviço (outline 1.5px, round caps). */
  icon?: IconName;
  title: string;
  description: string;
  eyebrow?: string;
  deliverables?: ReadonlyArray<string>;
  ctas: ReadonlyArray<ServiceCta>;
  /** SPEC-003 AC-003.2 — textual audience marker (non-color signal). */
  audience?: "b2b" | "clt";
  /** Optional pre-filled mailto body (AC-005.2: razão social + origin URL). */
  mailtoBody?: string;
  /** SPEC-012 — rendered locale (contact fallback route + pending note). */
  locale?: Locale;
}

const {
  slug,
  icon = "layers",
  title,
  description,
  eyebrow,
  deliverables,
  ctas,
  audience,
  mailtoBody,
  locale = DEFAULT_LOCALE,
} = Astro.props;
const isEn = locale === "en";

// Fail closed on missing labels (§C9 + SPEC-001): no undefined reaches the template.
ctas.forEach((cta, index) => {
  if (!cta.label) {
    throw new Error(
      `SPEC-002: ServiceCard '${slug}' possui CTA sem label (index ${index})`,
    );
  }
});

const mailtoCta = CONTACT_EMAIL
  ? ctas.find((cta) => typeof cta.subject === "string")
  : undefined;

const encodedMailto =
  mailtoCta && CONTACT_EMAIL
    ? buildMailtoHrefEncoded(
        CONTACT_EMAIL,
        mailtoCta.subject as string,
        mailtoBody,
      )
    : null;
---

<article
  data-testid={`service-card-${slug}`}
  class="card hover:shadow-card flex h-full flex-col gap-3 transition-shadow duration-200"
  {...audience ? { "data-audience": audience } : {}}
>
  <span
    data-testid={`service-icon-${slug}`}
    class="border-border text-link inline-flex h-10 w-10 items-center justify-center rounded-lg border"
  >
    <Icon name={icon} size={22} />
  </span>
  {
    eyebrow ? (
      <p class="text-ink-subtle text-xs font-semibold tracking-wide uppercase">
        {eyebrow}
      </p>
    ) : null
  }
  <h3 class="text-ink text-lg leading-snug font-bold">{title}</h3>
  <p class="text-ink-muted text-sm leading-relaxed">{description}</p>
  {
    deliverables && deliverables.length > 0 ? (
      <ul
        data-testid={`service-deliverables-${slug}`}
        class="text-ink-muted list-disc space-y-1 pl-5 text-sm"
      >
        {deliverables.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : null
  }
  <div class="mt-auto flex flex-col items-start gap-2 pt-2">
    {
      ctas.map((cta) =>
        cta.href ? (
          <a
            data-testid={`service-cta-${slug}`}
            href={withBase(cta.href)}
            class="btn btn-secondary"
          >
            {cta.label}
          </a>
        ) : HAS_CONTACT_EMAIL &&
          CONTACT_EMAIL &&
          encodedMailto &&
          cta.subject ? (
          <a
            data-testid={`service-cta-${slug}`}
            href={encodedMailto.hrefEncoded}
            aria-label={`${cta.label} — ${encodedMailto.addressDecoded}`}
            class="btn btn-secondary"
          >
            {cta.label}
          </a>
        ) : (
          <a
            data-testid={`service-cta-${slug}`}
            href={withBase(ROUTES.contact[locale])}
            title={
              isEn
                ? "Contact channel pending — decision D-03 (SDD-CONTEXT §9)"
                : "Canal de contato pendente — decisão D-03 (SDD-CONTEXT §9)"
            }
            class="btn btn-secondary"
          >
            {cta.label}
          </a>
        ),
      )
    }
  </div>
</article>
