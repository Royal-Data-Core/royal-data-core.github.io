---
/**
 * SPEC-010 §9 — sticky mobile CTA bar (mapa §5 · "Thumb Zone").
 *
 * Business intent: on mobile the primary conversion CTA ("Falar com
 * especialista") stays one thumb-tap away on every route — the highest-
 * impact mobile conversion pattern that costs zero bytes of JavaScript.
 *
 * Constraints:
 * - ZERO JS (SPEC-001 AC-001.8): no scroll listener, no IntersectionObserver.
 * - Zero tracker (CONSTITUTION §C7): no analytics event, no third party.
 * - The bar is `sm:hidden`; the desktop layout keeps its inline CTAs.
 * - `<nav aria-label>` landmark + a real link (not a button) — no fake UI.
 * - The destination is the same direct channel used by the final CTA
 *   (mailto, entity/percent-encoded per SPEC-005) — never a fake form.
 */
import { withBase } from "../lib/withBase";
import {
  CONTACT_EMAIL,
  CONTACT_SUBJECTS,
  buildMailtoHrefEncoded,
  defaultMailtoBody,
} from "../lib/contact";
import { DEFAULT_LOCALE, ROUTES, UI_STRINGS, type Locale } from "../lib/i18n";
import Icon from "./Icon.astro";

interface Props {
  /** Rendered locale (SPEC-012). */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = UI_STRINGS[locale];

/**
 * ADR-003 D4 rev. 2026-10-21 — PT-BR branch uses the bracket SSOT constant
 * plus the site-root auto-filled body; the EN branch keeps its inline literal
 * untouched (SPEC-012 zero-touch). Body added to the PT branch only.
 */
const siteOrigin = Astro.site?.origin ?? null;
const ptMailtoBody = siteOrigin
  ? defaultMailtoBody(`${siteOrigin}${withBase("/")}`)
  : undefined;

const encodedMailto =
  locale === "en"
    ? CONTACT_EMAIL &&
      buildMailtoHrefEncoded(
        CONTACT_EMAIL,
        "General enquiry — Royal Data Core (EN site)",
      )
    : CONTACT_EMAIL &&
      buildMailtoHrefEncoded(
        CONTACT_EMAIL,
        CONTACT_SUBJECTS.general,
        ptMailtoBody,
      );

const href = encodedMailto
  ? encodedMailto.hrefEncoded
  : withBase(ROUTES.contact[locale]);
const ariaLabel = encodedMailto
  ? `${ui.cta.mobileSpecialist} — ${encodedMailto.addressDecoded}`
  : ui.cta.mobileSpecialist;
---

<nav
  data-testid="mobile-cta-bar"
  aria-label={locale === "en" ? "Quick contact" : "Contato rápido"}
  class="border-border bg-surface/95 fixed inset-x-0 bottom-0 z-40 border-t px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] backdrop-blur-sm sm:hidden"
>
  <a
    data-testid="mobile-cta-contact"
    href={href}
    aria-label={ariaLabel}
    class="btn btn-primary w-full"
  >
    <Icon name="message-circle" size={18} />
    {ui.cta.mobileSpecialist}
  </a>
</nav>
