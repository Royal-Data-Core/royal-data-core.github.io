---
/**
 * SPEC-010 §4 — brand lockup (isotyper + wordmark).
 * SPEC-012 AC-012.1 — locale-aware accessible name (the link points at the
 * home of the CURRENT locale).
 *
 * Asset policy (SPEC-010 §8, PERF-3):
 * - `public/brand/isotyper-color-alpha.webp` — 512x465, ~18 KB (derivativo WebP do
 *   isotyper vetorial-color original; o SVG de 272 KB que embrulhou um JPEG
 *   foi descartado).
 * - The wordmark is TEXT (system stack), not an image: crisp at any density,
 *   zero bytes, translatable, and immune to raster blur.
 * - Explicit `width`/`height` on the `<img>` (intrinsic ratio) ⇒ CLS = 0.
 */
import { withBase } from "../lib/withBase";
import { DEFAULT_LOCALE, ROUTES, UI_STRINGS, type Locale } from "../lib/i18n";

interface Props {
  /** `header` = mark + name; `footer` = mark + name, muted. */
  variant?: "header" | "footer";
  /** Rendered locale (accessible name of the link). */
  locale?: Locale;
  /** Explicit accessible name (defaults to the locale-aware brand home). */
  label?: string;
}

const {
  variant = "header",
  locale = DEFAULT_LOCALE,
  label = UI_STRINGS[locale].brandHome,
} = Astro.props;
const markClass = variant === "footer" ? "h-9 w-auto opacity-90" : "h-9 w-auto";
---

<a
  href={withBase(ROUTES.home[locale])}
  data-testid="brand-lockup"
  aria-label={label}
  class="inline-flex min-h-[44px] items-center gap-2 rounded-md"
>
  <img
    src={withBase("/brand/isotyper-color-alpha.webp")}
    width="512"
    height="465"
    alt=""
    aria-hidden="true"
    decoding="async"
    class={markClass}
  />
  <span class="font-display text-ink text-base font-bold tracking-tight">
    Royal Data Core
  </span>
</a>
