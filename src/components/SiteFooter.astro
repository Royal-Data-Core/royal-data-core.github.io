---
/**
 * SPEC-009 AC-009.1 — legal footer on every route: razão social, CNPJ, Matão/SP,
 * privacy link, ≥1 contact channel, build-time year. Zero trackers (§C7).
 * D-03 resolved 2026-10-20: real channels + verified social links (footer
 * `footer-social-*` testids — /contato owns the `contact-*` ids for its cards).
 * Placeholder branches remain for env-less builds (SSOT honesty).
 * SPEC-012 AC-012.1 — locale-aware labels; the LEGAL FACTS (razão social, CNPJ,
 * address, channels) are identical in every locale — §C9 forbids hiding them.
 */
import { withBase } from "../lib/withBase";
import {
  CONTACT_EMAIL,
  CONTACT_EMAIL_DISPLAY,
  CONTACT_PHONE,
  CONTACT_PHONE_DISPLAY,
  CONTACT_SUBJECTS,
  CONTACT_SUBJECTS_EN,
  HAS_CONTACT_EMAIL,
  HAS_CONTACT_PHONE,
  buildMailtoHrefEncoded,
  buildWhatsAppHref,
  defaultMailtoBody,
} from "../lib/contact";
import {
  DEFAULT_LOCALE,
  ROUTES,
  UI_STRINGS,
  counterpartPath,
  type Locale,
} from "../lib/i18n";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  /** Rendered locale (SPEC-012). */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = UI_STRINGS[locale];
const targetLocale: Locale = locale === "pt-BR" ? "en" : "pt-BR";
const switchHref = counterpartPath(Astro.url.pathname, targetLocale);

const currentYear = new Date().getFullYear(); // build time only — never runtime JS

const legalName = "ROYAL DATA CORE LTDA";
const cnpj = "69.527.139/0001-94";
const locationLine = locale === "en" ? "Matão/SP, Brazil" : "Matão/SP, Brasil";

/**
 * ADR-003 D4 rev. 2026-10-21 + CR-001 §B/D5/D6 (FR-7) — SSG-deterministic
 * locale-detect: the EN surface lives under `/en/**`, so the footer derives the
 * branch from the built pathname. Subject comes from the SSOT table of that
 * locale (PT bracket constant until now; EN bracket constant on EN pages) and
 * the body template matches it. Body origin = root of the CURRENT locale
 * (`/en` on EN pages, `/` on PT pages); the D-03 guard stays honest — when
 * `Astro.site` is undefined the body is omitted, never hardcoded.
 */
const siteOrigin = Astro.site?.origin ?? null;
const isEn = Astro.url.pathname.startsWith(withBase("/en"));
const footerMailtoBody = siteOrigin
  ? defaultMailtoBody(
      `${siteOrigin}${withBase(isEn ? "/en" : "/")}`,
      isEn ? "en" : "pt",
    )
  : undefined;
const encodedMailto = CONTACT_EMAIL
  ? buildMailtoHrefEncoded(
      CONTACT_EMAIL,
      isEn ? CONTACT_SUBJECTS_EN.general : CONTACT_SUBJECTS.general,
      footerMailtoBody,
    )
  : null;
const whatsappHref =
  CONTACT_PHONE &&
  buildWhatsAppHref(
    CONTACT_PHONE,
    "Olá! Gostaria de conversar com a Royal Data Core (contato enviado pelo site).",
  );
---

<footer
  data-testid="site-footer"
  class="border-border bg-surface mt-12 border-t"
>
  <div class="container-page text-ink-muted space-y-4 py-8 text-sm">
    <p data-testid="footer-legal-name" class="text-ink font-semibold">
      {legalName}
      <span data-testid="footer-cnpj" class="font-normal">· CNPJ {cnpj}</span>
      <span>· {locationLine}</span>
    </p>
    <div
      data-testid="footer-contact-block"
      class="flex flex-wrap items-center gap-x-4 gap-y-2"
    >
      <p class="text-ink font-semibold">{ui.footer.contact}</p>
      {
        HAS_CONTACT_EMAIL && CONTACT_EMAIL && encodedMailto ? (
          <a
            data-testid="footer-contact-email-link"
            href={encodedMailto.hrefEncoded}
            aria-label={encodedMailto.addressDecoded}
            class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
            set:html={encodedMailto.textEncoded}
          />
        ) : HAS_CONTACT_EMAIL && CONTACT_EMAIL ? (
          <span data-testid="footer-contact-email-link">
            {CONTACT_EMAIL_DISPLAY}
          </span>
        ) : (
          <span
            data-testid="footer-contact-email-link"
            title="Canal de contato pendente — decisão D-03 (SDD-CONTEXT §9)"
          >
            {CONTACT_EMAIL_DISPLAY}
          </span>
        )
      }
      {
        HAS_CONTACT_PHONE && CONTACT_PHONE && whatsappHref ? (
          <a
            data-testid="footer-contact-whatsapp-link"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
          >
            WhatsApp
          </a>
        ) : HAS_CONTACT_PHONE && CONTACT_PHONE ? (
          <span data-testid="footer-contact-whatsapp-link">
            {CONTACT_PHONE_DISPLAY}
          </span>
        ) : (
          <span
            data-testid="footer-contact-whatsapp-link"
            title="Canal de contato pendente — decisão D-03 (SDD-CONTEXT §9)"
          >
            {CONTACT_PHONE_DISPLAY}
          </span>
        )
      }
      {
        [
          {
            label: "GitHub",
            href: "https://github.com/royaldatacore",
          },
          {
            label: "Instagram",
            href: "https://www.instagram.com/royaldatacore",
          },
          {
            label: "LinkedIn",
            href: "https://www.linkedin.com/in/leonardo-setti",
          },
        ].map((social) => (
          <a
            data-testid={`footer-social-${social.label.toLowerCase()}`}
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
          >
            {social.label}
          </a>
        ))
      }
    </div>
    <nav
      aria-label={locale === "en"
        ? "Institutional links"
        : "Links institucionais"}
      class="flex flex-wrap gap-x-4 gap-y-1"
    >
      <a
        href={withBase(ROUTES.services[locale])}
        class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        {ui.footer.services}
      </a>
      <a
        href={withBase(ROUTES.blog[locale])}
        class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        {ui.footer.blog}
      </a>
      <a
        href={withBase(ROUTES.contact[locale])}
        class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        {ui.footer.contactLink}
      </a>
      <a
        href={withBase(ROUTES.search[locale])}
        class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        {ui.footer.search}
      </a>
      <a
        data-testid="footer-privacy-link"
        href={withBase(ROUTES.privacy[locale])}
        class="hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        {ui.footer.privacy}
      </a>
    </nav>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <p>
        © {currentYear}
        {legalName}. {ui.footer.legalSuffix}
      </p>
      <LangSwitch
        locale={locale}
        target={targetLocale}
        href={switchHref}
        variant="full"
        class="text-ink-muted hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold underline underline-offset-4"
      />
    </div>
  </div>
</footer>
