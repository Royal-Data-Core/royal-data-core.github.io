---
/**
 * SPEC-009 AC-009.1 — legal footer on every route: razão social, CNPJ, Matão/SP,
 * privacy link, ≥1 contact channel, build-time year. Zero trackers (§C7).
 * D-03 pending: without PUBLIC_CONTACT_* the block shows the SSOT placeholders.
 */
import { withBase } from "../lib/withBase";
import {
  CONTACT_EMAIL,
  CONTACT_EMAIL_DISPLAY,
  CONTACT_PHONE,
  CONTACT_PHONE_DISPLAY,
  HAS_CONTACT_EMAIL,
  HAS_CONTACT_PHONE,
  buildMailtoHrefEncoded,
  buildWhatsAppHref,
  encodeHtmlEntities,
} from "../lib/contact";

const currentYear = new Date().getFullYear(); // build time only — never runtime JS

const legalName = "ROYAL DATA CORE LTDA";
const cnpj = "69.527.139/0001-94";
const locationLine = "Matão/SP, Brasil";

const encodedMailto =
  CONTACT_EMAIL &&
  buildMailtoHrefEncoded(CONTACT_EMAIL, "Contato geral — Royal Data Core");
const whatsappHref =
  CONTACT_PHONE &&
  buildWhatsAppHref(
    CONTACT_PHONE,
    "Olá! Gostaria de conversar com a Royal Data Core (contato enviado pelo site).",
  );
---

<footer
  data-testid="site-footer"
  class="bg-surface mt-12 border-t border-slate-200"
>
  <div class="mx-auto max-w-5xl space-y-4 px-4 py-8 text-sm text-slate-700">
    <p data-testid="footer-legal-name" class="font-semibold text-slate-900">
      {legalName}
      <span data-testid="footer-cnpj" class="font-normal">CNPJ {cnpj}</span>
      <span>· {locationLine}</span>
    </p>
    <div
      data-testid="footer-contact-block"
      class="flex flex-wrap items-center gap-x-4 gap-y-2"
    >
      <p class="font-semibold text-slate-900">Contato</p>
      {
        HAS_CONTACT_EMAIL && CONTACT_EMAIL && encodedMailto ? (
          <a
            data-testid="contact-email-link"
            href={encodedMailto.hrefEncoded}
            aria-label={encodedMailto.addressDecoded}
            class="hover:text-brand-700 inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
            set:html={encodedMailto.textEncoded}
          />
        ) : HAS_CONTACT_EMAIL && CONTACT_EMAIL ? (
          <span data-testid="contact-email-link">{CONTACT_EMAIL_DISPLAY}</span>
        ) : (
          <span
            data-testid="contact-email-link"
            title="Canal de contato pendente — decisão D-03 (SDD-CONTEXT §9)"
          >
            {CONTACT_EMAIL_DISPLAY}
          </span>
        )
      }
      {
        HAS_CONTACT_PHONE && CONTACT_PHONE && whatsappHref ? (
          <a
            data-testid="contact-whatsapp-link"
            href={encodeHtmlEntities(whatsappHref)}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-700 inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
          >
            WhatsApp
          </a>
        ) : HAS_CONTACT_PHONE && CONTACT_PHONE ? (
          <span data-testid="contact-whatsapp-link">
            {CONTACT_PHONE_DISPLAY}
          </span>
        ) : (
          <span
            data-testid="contact-whatsapp-link"
            title="Canal de contato pendente — decisão D-03 (SDD-CONTEXT §9)"
          >
            {CONTACT_PHONE_DISPLAY}
          </span>
        )
      }
    </div>
    <nav
      aria-label="Links institucionais"
      class="flex flex-wrap gap-x-4 gap-y-1"
    >
      <a
        href={withBase("/servicos")}
        class="hover:text-brand-700 inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        Serviços
      </a>
      <a
        href={withBase("/blog")}
        class="hover:text-brand-700 inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        Blog
      </a>
      <a
        href={withBase("/contato")}
        class="hover:text-brand-700 inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        Contato
      </a>
      <a
        href={withBase("/busca")}
        class="hover:text-brand-700 inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        Buscar
      </a>
      <a
        data-testid="footer-privacy-link"
        href={withBase("/privacidade")}
        class="hover:text-brand-700 inline-flex min-h-[44px] items-center rounded-md underline underline-offset-4"
      >
        Privacidade
      </a>
    </nav>
    <p>
      © {currentYear}
      {legalName}. Conteúdo e código deste site são auditáveis publicamente.
    </p>
  </div>
</footer>
