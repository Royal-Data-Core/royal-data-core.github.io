---
/**
 * SPEC-001 — Base Layout: single injection point for charset/viewport (AC-001.1),
 * CSP-meta + referrer (SPEC-008 AC-008.1/008.3), title template (AC-001.2),
 * canonical (AC-001.3), Open Graph + Twitter (AC-001.4), base JSON-LD
 * (AC-001.5/001.6), skip-link (AC-001.7), zero JS outside JSON-LD (AC-001.8).
 *
 * Props contract: { title, description, ogImage?, noIndex? } plus `fullTitle`,
 * `ogType`, `excludeFromSearch` (justified extensions: homepage full-title route,
 * article og:type, Pagefind exclusion per AC-007.3).
 */
import "../styles/global.css";
import { withBase } from "../lib/withBase";
import {
  buildOrganizationJsonLd,
  buildWebSiteJsonLd,
  serializeJsonLd,
} from "../lib/jsonld";
import {
  DEFAULT_LOCALE,
  HREFLANG,
  LOCALES,
  UI_STRINGS,
  type Locale,
} from "../lib/i18n";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileCtaBar from "../components/MobileCtaBar.astro";

interface Props {
  /** Page title (PT-BR). Applied to template `${title} · Royal Data Core` unless `fullTitle`. */
  title: string;
  /** Meta description (PT-BR, 80–160 chars per COPY-BRIEF §9). */
  description: string;
  ogImage?: string;
  /** 404 only: robots noindex,follow + NO canonical (SPEC-006 AC-006.3). */
  noIndex?: boolean;
  /** Homepage route: title prop is already the full brand title. */
  fullTitle?: boolean;
  /** Article pages emit the same browser-safe OG type. */
  ogType?: "website" | "article";
  /** Pagefind exclusion (`data-pagefind-ignore` on <body>, SPEC-007 AC-007.3). */
  excludeFromSearch?: boolean;
  /** SPEC-012 — rendered locale (drives html lang, hreflang, OG and JSON-LD). */
  locale?: Locale;
  /**
   * SPEC-012 AC-012.2 — counterpart paths per locale (WITHOUT the deployment
   * base). Only the locales that actually have this surface are listed; a
   * missing counterpart means NO `alternate` link is emitted (never a lie).
   */
  alternates?: Partial<Record<Locale, string | undefined>>;
}

const {
  title,
  description,
  ogImage,
  noIndex = false,
  fullTitle = false,
  ogType = "website",
  excludeFromSearch = false,
  locale = DEFAULT_LOCALE,
  alternates = {},
} = Astro.props;

const ui = UI_STRINGS[locale];
const htmlLang = locale === "en" ? "en" : "pt-BR";
const ogLocale = locale === "en" ? "en" : "pt_BR";

const site = Astro.site;
if (!site || site.protocol !== "https:") {
  throw new Error(
    "SPEC-001: 'site' é obrigatório e deve ser URL absoluta https://",
  );
}

// AC-001.2 — deterministic title template.
const displayTitle = fullTitle ? title : `${title} · Royal Data Core`;

// AC-001.3 — canonical derived from site + pathname; base-aware and slash-normalized.
// BASE_URL is inlined WITHOUT a guaranteed trailing slash ("/site-io") — normalize
// it before stripping, otherwise slice() yields a leading "/" and the re-prefix
// below produces "//route" (which withBase then treats as protocol-relative).
const rawBaseRaw = import.meta.env.BASE_URL ?? "/";
const rawBase =
  rawBaseRaw.length > 1 && !rawBaseRaw.endsWith("/")
    ? `${rawBaseRaw}/`
    : rawBaseRaw;
const pathname = Astro.url.pathname;
let routePath = pathname;
if (rawBase !== "/" && pathname.startsWith(rawBase)) {
  routePath = `/${pathname.slice(rawBase.length)}`;
}
routePath = routePath.replace(/\/+$/, "") || "/";
const canonicalPath = withBase(routePath);
const canonicalUrl = `${site.origin}${canonicalPath === "/" ? "/" : canonicalPath}`;
const ogImageUrl = new URL(
  ogImage
    ? withBase(ogImage)
    : withBase(locale === "en" ? "/og-en.png" : "/og-default.png"),
  site,
).toString();

// AC-001.5 / AC-001.6 — base JSON-LD blocks (scripts exempt from the no-JS rule as ld+json).
// SPEC-012 AC-012.3 — locale-aware: `inLanguage`/`areaServed` follow the
// rendered locale; the organization `@id` is IDENTICAL in every locale (one
// entity for search engines, not two competing ones).
const jsonLdOrganization = serializeJsonLd(
  buildOrganizationJsonLd(site, locale),
);
const jsonLdWebSite = serializeJsonLd(buildWebSiteJsonLd(site, locale));

// SPEC-012 AC-012.2 — hreflang reciprocity. `alternate` links are emitted
// ONLY for the locales that really have this surface; `x-default` points to
// the default-locale counterpart when it exists, otherwise to the site home.
const alternateEntries = LOCALES.map((loc) => ({
  locale: loc,
  path: alternates[loc],
})).filter((entry): entry is { locale: Locale; path: string } =>
  Boolean(entry.path),
);
// `x-default` only makes sense on a page that HAS a locale counterpart
// (a PT-only page — e.g. a tag listing — declares no alternate at all).
const hasLocaleAlternate = alternateEntries.length > 0;
const xDefaultPath = hasLocaleAlternate
  ? (alternates[DEFAULT_LOCALE] ??
    (locale === DEFAULT_LOCALE ? undefined : "/"))
  : undefined;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- [ADR-002] frame-ancestors/report-uri são ignorados em meta-tag; ver RRR-01/RRR-04 -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; base-uri 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- GSC verification (URL-prefix property) — token público por design
         (prova de posse, não segredo — SEC-1 intacto). Proprietário: operador. -->
    <meta
      name="google-site-verification"
      content="czHutUqNynxq2znDCR3n18jDk5OpM8hUXQ5CFjCvAow"
    />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex, follow" /> : null}
    {noIndex ? null : <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#1d4ed8" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Royal Data Core — artigos"
      href={withBase("/rss.xml")}
    />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {noIndex ? null : <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    {
      alternateEntries
        .filter((entry) => entry.locale !== locale)
        .map((entry) => (
          <meta
            property="og:locale:alternate"
            content={entry.locale === "en" ? "en" : "pt_BR"}
          />
        ))
    }
    {
      alternateEntries.map((entry) => (
        <link
          rel="alternate"
          hreflang={HREFLANG[entry.locale]}
          href={new URL(withBase(entry.path), site).href}
        />
      ))
    }
    {
      xDefaultPath ? (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(withBase(xDefaultPath), site).href}
        />
      ) : null
    }
    <!-- SPEC-012 — Pagefind index filter: each surface indexes its own locale. -->
    <meta data-pagefind-filter="locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script
      type="application/ld+json"
      data-testid="jsonld-organization"
      is:inline
      set:html={jsonLdOrganization}
    />
    <script
      type="application/ld+json"
      data-testid="jsonld-website"
      is:inline
      set:html={jsonLdWebSite}
    />
    <slot name="head" />
  </head>
  <body
    class="flex min-h-screen flex-col pb-24 sm:pb-0"
    data-pagefind-ignore={excludeFromSearch ? "" : undefined}
  >
    <a
      data-testid="skip-link"
      href="#conteudo-principal"
      class="focus:bg-accent focus:text-on-accent sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:px-4 focus:py-3 focus:text-base focus:font-semibold"
    >
      {ui.skipLink}
    </a>
    <SiteHeader locale={locale} />
    <main
      id="conteudo-principal"
      data-testid="main-content"
      tabindex="-1"
      class="flex-1"
    >
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <MobileCtaBar locale={locale} />
    <!-- Conformance oracle: no script may follow JSON-LD into the artifact (AC-001.8). -->
  </body>
</html>
