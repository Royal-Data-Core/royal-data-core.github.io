---
/**
 * SPEC-007 — /busca landing (SearchAction target). The ONLY page with shipped
 * JavaScript: Pagefind index + WASM, loaded from same origin (`/_pagefind/`).
 *
 * SPEC-012 — the page renders the shared `SearchApp` component, filtered to
 * the pt-BR locale (the EN surface has its own route at /en/search).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchApp from "../components/SearchApp.astro";

const SITE_DESCRIPTION =
  "Busca full-text executada no seu navegador. Nenhum termo é enviado a servidor.";
---

<BaseLayout
  title="Buscar"
  description={SITE_DESCRIPTION}
  locale="pt-BR"
  alternates={{ "pt-BR": "/busca", en: "/en/search" }}
>
  <div class="container-page py-10">
    <h1 class="text-ink text-3xl leading-tight font-bold tracking-tight">
      Buscar
    </h1>
    <SearchApp locale="pt-BR" />
  </div>
</BaseLayout>
