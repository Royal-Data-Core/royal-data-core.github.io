---
/**
 * SPEC-004 — /blog/[slug]: h1 = frontmatter title, PT-BR long date, tags links,
 * TOC with anchors for every h2, BlogPosting JSON-LD, server-side Shiki.
 * drafts: excluded (AC-004.2).
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/withBase";
import { formatPublishDate, toIsoDate } from "../../lib/date";
import { ORGANIZATION, serializeJsonLd } from "../../lib/jsonld";
import { postSlug } from "../../lib/i18n";
import type { JsonLdNode } from "../../lib/jsonld";

import type { CollectionEntry } from "astro:content";

export async function getStaticPaths(): Promise<
  Array<{
    params: { slug: string };
    props: { post: CollectionEntry<"blog">; hasEnCounterpart: boolean };
  }>
> {
  const postEntries = await getCollection("blog");
  const published = postEntries
    .filter((post) => !post.data.draft && post.data.lang === "pt-BR")
    .sort(
      (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
    );
  if (published.length === 0) {
    throw new Error(
      "SPEC-004: nenhum post publicado — o blog não pode gerar rotas",
    );
  }
  // SPEC-012 — the EN counterpart exists only when the article was actually
  // translated; the `alternate` link must never point to a 404.
  const enSlugs = new Set(
    postEntries
      .filter((post) => !post.data.draft && post.data.lang === "en")
      .map((post) => postSlug(post.id, "en")),
  );
  return published.map((post) => ({
    params: { slug: post.id },
    props: { post, hasEnCounterpart: enSlugs.has(post.id) },
  }));
}

const { post, hasEnCounterpart } = Astro.props;
const { Content, headings } = await render(post);

const toc = headings.filter((heading) => heading.depth === 2);

const ogDescription = post.data.description;

/** AC-004.4 — BlogPosting block; author identity pending is named honestly. */
const siteOrigin: string = import.meta.env.SITE ?? "";
const mainEntityOfPage = `${siteOrigin}${withBase(`blog/${post.id}`)}`;
const blogPostingJsonLd: JsonLdNode = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: toIsoDate(post.data.publishDate),
  dateModified: toIsoDate(post.data.updatedDate ?? post.data.publishDate),
  author: {
    "@type": "Person",
    name: "Profissional de QA — Royal Data Core",
  },
  publisher: {
    "@type": "Organization",
    name: ORGANIZATION.name,
  },
  mainEntityOfPage,
  inLanguage: post.data.lang === "pt-BR" ? "pt-BR" : "en",
};
---

<BaseLayout
  title={post.data.title}
  description={ogDescription}
  ogType="article"
  locale="pt-BR"
  alternates={{
    "pt-BR": `/blog/${post.id}`,
    en: hasEnCounterpart ? `/en/blog/${postSlug(post.id, "en")}` : undefined,
  }}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(blogPostingJsonLd)}
  />

  <div data-theme="mid" class="bg-bg">
    <article class="mx-auto max-w-3xl px-4 py-10">
      <header class="space-y-3">
        <h1
          data-testid="article-headline"
          class="text-ink text-3xl leading-tight font-bold tracking-tight"
        >
          {post.data.title}
        </h1>
        <p class="text-ink-subtle flex flex-wrap items-center gap-x-2 text-sm">
          <time datetime={toIsoDate(post.data.publishDate)}>
            {formatPublishDate(post.data.publishDate)}
          </time>
          {
            post.data.updatedDate ? (
              <span>
                · atualizado em{" "}
                <time datetime={toIsoDate(post.data.updatedDate)}>
                  {formatPublishDate(post.data.updatedDate)}
                </time>
              </span>
            ) : null
          }
        </p>
        {
          post.data.tags.length > 0 ? (
            <ul data-testid="post-tags" class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li>
                  <a
                    href={withBase(`/blog/tag/${tag}`)}
                    class="hover:border-accent hover:text-link-hover border-border-strong text-ink-muted inline-flex min-h-[44px] items-center rounded-md border px-3 text-xs font-semibold"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          ) : null
        }
      </header>

      {
        toc.length > 0 ? (
          <nav
            data-testid="post-toc"
            aria-label="Sumário do artigo"
            class="bg-surface border-border mt-6 rounded-md border p-4"
          >
            <p class="text-ink text-sm font-semibold">Neste artigo</p>
            <ul class="text-ink-muted mt-2 list-disc space-y-0.5 pl-5 text-sm">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="text-link hover:text-link-hover inline-block py-2 align-baseline underline underline-offset-4"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null
      }

      <div
        data-testid="post-body"
        class="text-ink [&_li]:text-ink [&_p]:text-ink mt-8 space-y-4 leading-relaxed [&_h2]:text-xl [&_h2]:leading-snug [&_h2]:font-bold [&_h3]:text-lg [&_h3]:font-semibold [&_pre]:overflow-x-auto"
      >
        <Content />
      </div>

      {
        post.data.references.length > 0 ? (
          <aside
            class="bg-surface border-border mt-10 rounded-md border p-4"
            aria-label="Referências"
          >
            <p class="text-ink text-sm font-semibold">Referências</p>
            <ul class="text-ink-muted mt-2 list-disc space-y-0.5 pl-5 text-sm">
              {post.data.references.map((reference) => (
                <li>
                  <a
                    href={reference.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-link hover:text-link-hover inline-block py-2 align-baseline underline underline-offset-4"
                  >
                    {reference.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        ) : null
      }

      <nav aria-label="Navegação de artigos" class="mt-10 flex flex-wrap gap-4">
        <a
          href={withBase("/blog")}
          class="text-link hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold underline underline-offset-4"
        >
          Todos os artigos
        </a>
        <a
          href={withBase("/contato")}
          class="text-link hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold underline underline-offset-4"
        >
          Falar sobre este artigo
        </a>
      </nav>
    </article>
  </div>
</BaseLayout>
