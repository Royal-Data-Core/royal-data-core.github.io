---
/**
 * SPEC-004 — /blog/[slug]: h1 = frontmatter title, PT-BR long date, tags links,
 * TOC with anchors for every h2, BlogPosting JSON-LD, server-side Shiki.
 * drafts: excluded (AC-004.2).
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/withBase';
import { formatPublishDate, toIsoDate } from '../../lib/date';
import { ORGANIZATION, serializeJsonLd } from '../../lib/jsonld';
import type { JsonLdNode } from '../../lib/jsonld';

import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths(): Promise<Array<{ params: { slug: string }; props: { post: CollectionEntry<'blog'> } }>> {
  const postEntries = await getCollection('blog');
  const published = postEntries
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  if (published.length === 0) {
    throw new Error('SPEC-004: nenhum post publicado — o blog não pode gerar rotas');
  }
  return published.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const toc = headings.filter((heading) => heading.depth === 2);

const ogDescription = post.data.description;

/** AC-004.4 — BlogPosting block; author identity pending is named honestly. */
const siteOrigin: string = import.meta.env.SITE ?? '';
const mainEntityOfPage = `${siteOrigin}${withBase(`blog/${post.id}`)}`;
const blogPostingJsonLd: JsonLdNode = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: toIsoDate(post.data.publishDate),
  dateModified: toIsoDate(post.data.updatedDate ?? post.data.publishDate),
  author: {
    '@type': 'Person',
    name: 'Profissional de QA — Royal Data Core',
  },
  publisher: {
    '@type': 'Organization',
    name: ORGANIZATION.name,
  },
  mainEntityOfPage,
  inLanguage: post.data.lang === 'pt-BR' ? 'pt-BR' : 'en',
};
---

<BaseLayout title={post.data.title} description={ogDescription} ogType="article">
  <script slot="head" type="application/ld+json" is:inline set:html={serializeJsonLd(blogPostingJsonLd)} />

  <article class="mx-auto max-w-3xl px-4 py-10">
    <header class="space-y-3">
      <h1 data-testid="article-headline" class="text-3xl font-bold leading-tight tracking-tight text-slate-900">
        {post.data.title}
      </h1>
      <p class="flex flex-wrap items-center gap-x-2 text-sm text-slate-600">
        <time datetime={toIsoDate(post.data.publishDate)}>
          {formatPublishDate(post.data.publishDate)}
        </time>
        {
          post.data.updatedDate ? (
            <span>
              · atualizado em <time datetime={toIsoDate(post.data.updatedDate)}>
                {formatPublishDate(post.data.updatedDate)}
              </time>
            </span>
          ) : null
        }
      </p>
      {
        post.data.tags.length > 0 ? (
          <ul data-testid="post-tags" class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li>
                <a
                  href={withBase(`/blog/tag/${tag}`)}
                  class="inline-flex min-h-[44px] items-center rounded-md border border-slate-300 px-3 text-xs font-semibold text-slate-700 hover:border-brand-700 hover:text-brand-700"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </header>

    {
      toc.length > 0 ? (
        <nav data-testid="post-toc" aria-label="Sumário do artigo" class="mt-6 rounded-md border border-slate-200 bg-surface p-4">
          <p class="text-sm font-semibold text-slate-900">Neste artigo</p>
          <ul class="mt-2 list-disc pl-5 text-sm text-slate-700">
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`} class="text-brand-700 underline underline-offset-4 hover:text-brand-900">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : null
    }

    <div data-testid="post-body" class="mt-8 space-y-4 leading-relaxed text-slate-800 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:leading-snug [&_h3]:text-lg [&_h3]:font-semibold [&_li]:text-slate-800 [&_p]:text-slate-800 [&_pre]:overflow-x-auto">
      <Content />
    </div>

    {
      post.data.references.length > 0 ? (
        <aside class="mt-10 rounded-md border border-slate-200 bg-surface p-4" aria-label="Referências">
          <p class="text-sm font-semibold text-slate-900">Referências</p>
          <ul class="mt-2 list-disc pl-5 text-sm text-slate-700">
            {post.data.references.map((reference) => (
              <li>
                <a
                  href={reference.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-brand-700 underline underline-offset-4 hover:text-brand-900"
                >
                  {reference.label}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      ) : null
    }

    <nav aria-label="Navegação de artigos" class="mt-10 flex flex-wrap gap-4">
      <a
        href={withBase('/blog')}
        class="inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-900"
      >
        Todos os artigos
      </a>
      <a
        href={withBase('/contato')}
        class="inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-900"
      >
        Falar sobre este artigo
      </a>
    </nav>
  </article>
</BaseLayout>
