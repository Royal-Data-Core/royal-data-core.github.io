---
/**
 * SPEC-004 — /blog listing: ordered by publishDate desc, PT-BR long dates on
 * cards, reading time. Pagination is omitted while the collection has < 11
 * published posts (AC-004.3 is bound "Given 14 posts").
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { withBase } from "../../lib/withBase";
import { readingMinutes } from "../../lib/date";

const SITE_DESCRIPTION =
  "Conteúdo técnico sobre automação, testes flaky, pipelines de QA, Playwright e engenharia de qualidade. Sem rodeio.";

const postEntries = await getCollection("blog");
const publishedPosts = postEntries
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const allTags = new Set<string>();
publishedPosts.forEach((post) =>
  post.data.tags.forEach((tag) => allTags.add(tag)),
);
---

<BaseLayout
  title="Artigos sobre Testes de Software"
  description={SITE_DESCRIPTION}
>
  <div data-theme="dark" class="bg-bg">
    <div class="container-page py-10">
      <h1 class="text-ink text-3xl leading-tight font-bold tracking-tight">
        Artigos sobre testes de software
      </h1>
      <p class="text-ink-muted mt-3 max-w-2xl text-sm leading-relaxed">
        O que eu testo, quebro e aprendo. Sem rodeio.
      </p>

      {
        allTags.size > 0 ? (
          <p class="mt-4">
            <span class="text-ink text-sm font-semibold">Tags: </span>
            {Array.from(allTags).map((tag) => (
              <a
                href={withBase(`/blog/tag/${tag}`)}
                class="text-link hover:text-link-hover mr-2 inline-flex min-h-[44px] items-center rounded-md text-sm underline underline-offset-4"
              >
                {tag}
              </a>
            ))}
          </p>
        ) : null
      }

      {
        publishedPosts.length > 0 ? (
          <div
            data-testid="post-list"
            class="reveal mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
          >
            {publishedPosts.map((post) => (
              <PostCard
                title={post.data.title}
                publishDate={post.data.publishDate}
                href={`blog/${post.id}`}
                slug={post.id}
                readingTimeMinutes={readingMinutes(post.body)}
                description={post.data.description}
              />
            ))}
          </div>
        ) : (
          <p class="text-ink-muted mt-6 text-sm">
            Ainda publicando os primeiros artigos. Volte em breve — ou assine o
            RSS.
          </p>
        )
      }

      <p class="text-ink-muted mt-8 text-sm">
        RSS:{" "}
        <a
          data-testid="rss-link"
          href={withBase("/rss.xml")}
          class="text-link hover:text-link-hover underline underline-offset-4"
        >
          assinar via /rss.xml
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
