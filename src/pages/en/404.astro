---
/**
 * SPEC-006 — /en/404: English recovery page for the English surface.
 * The requested path is rendered as TEXT ONLY — never as HTML (AC-006.N1).
 * The site's root 404 (dist/404.html) remains the PT-BR one; this page is
 * reachable at /en/404 and keeps the EN visitor inside the EN surface.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/withBase";
import {
  CONTACT_EMAIL,
  CONTACT_SUBJECTS_EN,
  buildMailtoHrefEncoded,
  defaultMailtoBody,
} from "../../lib/contact";
import { ROUTES } from "../../lib/i18n";

const SITE_DESCRIPTION =
  "Address not found. Choose a destination: home, articles, services or search.";

// Same site-derivation mechanism as the PT 404.astro (CR-001 §D6); the EN 404
// origin is the locale root `/en`.
const site = import.meta.env.SITE ?? "https://royaldatacore.github.io";

const requestedPathHint =
  "the address you opened does not exist on this site (it may have been moved, renamed, or never existed).";

const brokenLinkMailto =
  CONTACT_EMAIL &&
  buildMailtoHrefEncoded(
    CONTACT_EMAIL,
    CONTACT_SUBJECTS_EN.linkBroken,
    defaultMailtoBody(`${site}${withBase(ROUTES.home.en)}`, "en"),
  );
---

<BaseLayout
  title="Page not found — Royal Data Core"
  description={SITE_DESCRIPTION}
  noIndex
  locale="en"
>
  <div class="container-page py-12">
    <h1 class="text-ink text-3xl leading-tight font-bold tracking-tight">
      Page not found
    </h1>
    <p class="text-ink-muted mt-3 max-w-2xl text-sm leading-relaxed">
      <span data-testid="404-requested-path">{requestedPathHint}</span>
    </p>
    <nav
      aria-label="Recovery links"
      class="mt-6 flex flex-col items-start gap-3"
    >
      <a
        data-testid="404-link-home"
        href={withBase(ROUTES.home.en)}
        class="btn btn-primary"
      >
        Go to the home page
      </a>
      <a
        data-testid="404-link-blog"
        href={withBase(ROUTES.blog.en)}
        class="btn btn-secondary"
      >
        Read the articles
      </a>
      <a
        data-testid="404-link-services"
        href={withBase(ROUTES.services.en)}
        class="btn btn-secondary"
      >
        See the services
      </a>
      <a
        data-testid="404-search-hint"
        href={withBase(ROUTES.search.en)}
        class="text-link hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold underline underline-offset-4"
      >
        Search the articles
      </a>
      {
        brokenLinkMailto ? (
          <a
            data-testid="404-contact-hint"
            href={brokenLinkMailto.hrefEncoded}
            class="text-link hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold underline underline-offset-4"
          >
            Report a broken link
          </a>
        ) : (
          <a
            data-testid="404-contact-hint"
            href={withBase(ROUTES.contact.en)}
            class="text-link hover:text-link-hover inline-flex min-h-[44px] items-center rounded-md text-sm font-semibold underline underline-offset-4"
          >
            Report a broken link
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>
